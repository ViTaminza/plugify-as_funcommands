{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${AS_FUNCOMMANDS_VERSION}",
	"name": "as_funcommands",
	"description": "Admin fun commands for admin_system (port of the Pisex Metamod:Source module 'FunCommands'): gravity, hp, armor, scale, speed, god mode, freeze, blind, bury and unbury as console commands (mm_gravity, mm_hp, mm_armor, mm_scale, mm_speed, mm_god, mm_freezy, mm_unfreezy, mm_blind, mm_unblind, mm_bury, mm_unbury) and as the 'players' category of the admin menu (target picker + value menus, like the original). Every command and item needs its @admin/<name> permission from the admin_system core; the admin-data readiness of the caller is checked before every permission decision. Written directly against s2sdk: no pisexcompat and no shared wrapper library. The menus use the s2sdk menu manager; the player's own '!menu' type comes from the optional hudmenu plugin API, otherwise the Pisex default (the 'hud' type when its backend is registered, else 'button'). No exported methods.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/as_funcommands",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "admin_system",
			"constraints": ">=1.1.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
